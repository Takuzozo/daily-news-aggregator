# Feishu/Lark App credentials (required)
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Personal Access Token (optional, used as fallback for Trending API)
GH_TRENDING_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Limits per category (default: 10)
AI_NEWS_LIMIT=10
GITHUB_TRENDING_LIMIT=10
WORLD_NEWS_LIMIT=10

# Dedup: how many days to remember seen URLs (default: 3)
DEDUP_DAYS=3

# Log level (default: INFO)
LOG_LEVEL=INFO
